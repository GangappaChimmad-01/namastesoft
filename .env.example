# Analytics (optional). Nothing loads until one ID is set. Set these in Vercel → Project → Settings →
# Environment Variables (Production), then redeploy: they are read at build time.

# Google Tag Manager container ID (preferred). When set, GA4 must be added as a tag inside GTM,
# and VITE_GA4_MEASUREMENT_ID is ignored so page views are not counted twice.
VITE_GTM_CONTAINER_ID=

# GA4 Measurement ID, used only when no GTM container is set.
VITE_GA4_MEASUREMENT_ID=

# Default Consent Mode v2 state for analytics_storage: granted (default) or denied.
# Ad storage / personalisation are always denied. Use "denied" if you add a cookie banner that grants consent.
VITE_ANALYTICS_CONSENT=granted
