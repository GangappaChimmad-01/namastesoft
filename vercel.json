{
	"headers": [
		{
			"source": "/updates/(.*\\.yml)",
			"headers": [
				{ "key": "Access-Control-Allow-Origin", "value": "*" },
				{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
				{ "key": "Content-Type", "value": "text/yaml; charset=utf-8" }
			]
		},
		{
			"source": "/updates/(.*)",
			"headers": [
				{ "key": "Access-Control-Allow-Origin", "value": "*" },
				{ "key": "Content-Type", "value": "application/octet-stream" }
			]
		}
	]
}
